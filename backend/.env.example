# Database
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/priceiq?sslmode=require

# Amazon Product Advertising API (apply at affiliate-program.amazon.in)
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_PARTNER_TAG=your_associate_tag
AMAZON_REGION=IN

# Flipkart Affiliate API (apply at affiliate.flipkart.com)
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id
FLIPKART_AFFILIATE_TOKEN=your_flipkart_token

# OpenWeatherMap (free at openweathermap.org/api — 1000 calls/day free)
OPENWEATHER_API_KEY=your_openweather_key

# RapidAPI (optional - for live grocery/food data)
RAPIDAPI_KEY=your_rapidapi_key

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
